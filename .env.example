# Optional: GitHub token for committing snapshots to repo
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: enables manual/external snapshots via /api/cron/snapshot
# (send as "Authorization: Bearer <secret>"). Leave unset to disable the endpoint;
# the built-in daily scheduler works without it.
# CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: snapshot storage directory (default: ./data)
# DATA_DIR=/var/lib/hiveos-stats/data

# Optional: cache directory for generated Excel exports (default: OS temp dir)
# EXPORT_CACHE_DIR=/var/cache/hiveos-stats/exports

# Optional: dead man's switch. Pinged after every successful daily snapshot,
# e.g. a Healthchecks.io check URL, so a missed day alerts you.
# HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid
