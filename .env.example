# Optional: GitHub token for committing snapshots to repo
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: enables manual/external snapshots via /api/cron/snapshot
# (send as "Authorization: Bearer <secret>"). Leave unset to disable the endpoint;
# the built-in daily scheduler works without it.
# CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: snapshot storage directory (default: ./data)
# DATA_DIR=/var/lib/hiveos-stats/data
